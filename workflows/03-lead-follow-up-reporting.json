      "name": "Get Leads For Report"
    },
    {
      "parameters": {
        "jsCode": "const leads = $input.all();\n\nconst totalLeads = leads.length;\n\nlet highPriority = 0;\nlet mediumPriority = 0;\nlet lowPriority = 0;\n\nlet newLeads = 0;\nlet contactedLeads = 0;\nlet interestedLeads = 0;\nlet notInterestedLeads = 0;\nlet convertedLeads = 0;\n\nfor (const lead of leads) {\n\n  if (lead.json.priority === 'High Priority') {\n    highPriority++;\n  } else if (lead.json.priority === 'Medium Priority') {\n    mediumPriority++;\n  } else if (lead.json.priority === 'Low Priority') {\n    lowPriority++;\n  }\n\n  if (lead.json.status === 'New') {\n    newLeads++;\n  } else if (lead.json.status === 'Contacted') {\n    contactedLeads++;\n  } else if (lead.json.status === 'Interested') {\n    interestedLeads++;\n  } else if (lead.json.status === 'Not Interested') {\n    notInterestedLeads++;\n  } else if (lead.json.status === 'Converted') {\n    convertedLeads++;\n  }\n}\n\nreturn {\n  json: {\n    totalLeads,\n    highPriority,\n    mediumPriority,\n    lowPriority,\n    newLeads,\n    contactedLeads,\n    interestedLeads,\n    notInterestedLeads,\n    convertedLeads\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        160
      ],
